eWarningCount":0,"usedDeprecatedRules":"31"},{"filePath":"34","messages":"35","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"31"},{"filePath":"36","messages":"37","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"31"},{"filePath":"38","messages":"39","errorCount":0,"warningCount":3,"fixableErrorCount":0,"fixableWarningCount":0,"source":"40","usedDeprecatedRules":"31"},{"filePath":"41","messages":"42","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"31"},{"filePath":"43","messages":"44","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"31"},{"filePath":"45","messages":"46","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"47","messages":"48","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"31"},"C:\\Users\\tsapo\\Github\\walk-hero\\src\\index.js",[],"C:\\Users\\tsapo\\Github\\walk-hero\\src\\reportWebVitals.js",[],"C:\\Users\\tsapo\\Github\\walk-hero\\src\\App.js",["49"],"import React from \"react\";\nimport { Container, Row, Col } from \"reactstrap\";\n\nimport { CUSTOMEVENTS } from \"./enums\";\nimport {\n  toLatLong,\n  startPoll,\n  killPoll,\n  getStartingPoint,\n  cloneGeoData,\n} from \"./services/Geo\";\nimport cityWorker from \"workerize-loader!./workers/cities\"; // eslint-disable-line import/no-webpack-loader-syntax\nimport measureWorker from \"workerize-loader!./workers/measurements\"; // eslint-disable-line import/no-webpack-loader-syntax\n\nimport DisplayData from \"./components/DisplayData/DisplayData\";\nimport Map from \"./components/Map/Map\";\nimport BottomNav from \"./components/BottomNav/BottomNav\";\n\nconst CityWorker = cityWorker();\nconst MeasurementWorker = measureWorker();\n\nclass App extends React.Component {\n  constructor(props) {\n    super(props);\n\n    this.state = {\n      dataModalOpen: false,\n      geoData: {\n        coords: {},\n      },\n      farthestGeoDataFromStart: null,\n      hasLocation: false,\n      start: false,\n      distanceFromStartCM: 0,\n      prevGeoData: {},\n      distanceTraveledInCM: 0,\n      totalDistanceTraveledInCM: 0,\n      startingLocation: {},\n    };\n\n    this.poll = null;\n    this.map = null;\n  }\n\n  componentDidMount() {\n    this.poll = startPoll(this.success);\n    getStartingPoint(this.setStart);\n    this.cityPoll = setInterval(\n      () => this.getCurrentCity(cloneGeoData(this.state.geoData)),\n      12000\n    );\n    window.addEventListener(\n      CUSTOMEVENTS.DATA_MODAL_TOGGLE,\n      this.dataModalToggle\n    );\n  }\n\n  componentWillUnmount() {\n    killPoll(this.poll);\n    clearInterval(this.cityPoll);\n    window.removeEventListener(\n      CUSTOMEVENTS.DATA_MODAL_TOGGLE,\n      this.dataModalToggle\n    );\n  }\n\n  dataModalToggle = () => {\n    this.setState({\n      dataModalOpen: !this.state.dataModalOpen,\n    });\n  };\n\n  setStart = (data) => {\n    const latLong = toLatLong(data);\n    this.setState({ start: data, geoData: data }, () => {\n      this.getCurrentCity(cloneGeoData(data));\n    });\n  };\n\n  getCurrentCity = (latLong) => {\n    CityWorker.getEntryByLatLong(latLong).then((value) => {\n      if (value.length !== 0) {\n        this.setState({ startingLocation: value[0] });\n      } else {\n        this.setState({\n          failedAtCity: true,\n          startingLocation: {\n            name: \"Could not find city\",\n            country: \"Could not find country\",\n          },\n        });\n      }\n    });\n  };\n\n  success = (geoData) => {\n    this.calculateFarthestGeo(geoData);\n    this.calculatePointToPointFromStart(geoData);\n    this.calculateTotalDistanceTraveledInCM(geoData);\n\n    this.setState({\n      geoData,\n    });\n  };\n\n  calculatePointToPointFromStart = (_geoData) => {\n    let _distFromStart = null;\n\n    MeasurementWorker.distBetweenInCM(\n      cloneGeoData(this.state.start),\n      cloneGeoData(_geoData)\n    ).then((value) => {\n      _distFromStart = value;\n      this.setState({\n        distanceFromStartCM: _distFromStart,\n      });\n    });\n  };\n\n  calculateTotalDistanceTraveledInCM = (_geoData) => {\n    let _distTraveled = null;\n\n    MeasurementWorker.distBetweenInCM(\n      cloneGeoData(_geoData),\n      cloneGeoData(this.state.geoData)\n    ).then((value) => {\n      _distTraveled = value;\n      if (_distTraveled >= 500) {\n        this.setState({\n          totalDistanceTraveledInCM:\n            this.state.totalDistanceTraveledInCM + _distTraveled,\n        });\n      }\n      this.setState({\n        distanceTraveledInCM: _distTraveled,\n      });\n    });\n  };\n\n  calculateFarthestGeo = (_geoData) => {\n    let _farthestGeoData = null;\n\n    if (this.state.farthestGeoDataFromStart) {\n      MeasurementWorker.distBetweenInCM(\n        cloneGeoData(this.state.farthestGeoDataFromStart),\n        cloneGeoData(this.state.start)\n      ).then((value1) => {\n        MeasurementWorker.distBetweenInCM(\n          cloneGeoData(_geoData),\n          cloneGeoData(this.state.farthestGeoDataFromStart)\n        ).then((value2) => {\n          if (value2 > value1) {\n            _farthestGeoData = _geoData;\n            this.setState({ farthestGeoDataFromStart: _farthestGeoData });\n          }\n        });\n      });\n    } else {\n      _farthestGeoData = _geoData;\n      this.setState({ farthestGeoDataFromStart: _farthestGeoData });\n    }\n  };\n\n  render() {\n    return (\n      <Container>\n        <Row>\n          <DisplayData\n            {...this.state}\n            modalProps={{\n              isOpen: this.state.dataModalOpen,\n              toggle: this.dataModalToggle,\n            }}\n          />\n          <Col xs={12}>\n            <Map geoData={this.state.geoData} />\n          </Col>\n        </Row>\n        <BottomNav />\n      </Container>\n    );\n  }\n}\n\nexport default App;\n",["50","51"],"C:\\Users\\tsapo\\Github\\walk-hero\\src\\services\\Geo.js",[],"C:\\Users\\tsapo\\Github\\walk-hero\\src\\workers\\cities.js",[],"C:\\Users\\tsapo\\Github\\walk-hero\\src\\workers\\measurements.js",[],"C:\\Users\\tsapo\\Github\\walk-hero\\src\\components\\DisplayData\\DisplayData.js",["52","53","54"],"import React from \"react\";\r\nimport PropTypes from \"prop-types\";\r\nimport {\r\n  Table,\r\n  Badge,\r\n  Modal,\r\n  ModalBody,\r\n  ModalFooter,\r\n  ModalHeader,\r\n} from \"reactstrap\";\r\n\r\nimport { toTime, toLatLong } from \"./../../services/Geo\";\r\n\r\nfunction DisplayData(props) {\r\n  return (\r\n    <Modal>\r\n      {props.start && (\r\n        <React.Fragment>\r\n          <h2>Starting Data</h2>\r\n          <Table responsive>\r\n            <thead>\r\n              <tr>\r\n                <th>lat</th>\r\n                <th>lng</th>\r\n                <th>city</th>\r\n                <th>country</th>\r\n                <th>datetime</th>\r\n              </tr>\r\n            </thead>\r\n            <tbody>\r\n              <tr>\r\n                <td>{toLatLong(props.start)[0]}</td>\r\n                <td>{toLatLong(props.start)[1]}</td>\r\n                <td>{props.startingLocation.name}</td>\r\n                <td>{props.startingLocation.country}</td>\r\n                <td>{toTime(props.start)}</td>\r\n              </tr>\r\n            </tbody>\r\n          </Table>\r\n\r\n          <h2>Current Traveling</h2>\r\n          <Table responsive>\r\n            <thead>\r\n              <tr>\r\n                <th>cm from start</th>\r\n                <th>cm just traveled</th>\r\n                <th>total cm</th>\r\n                <th>lat</th>\r\n                <th>lng</th>\r\n                <th>time</th>\r\n              </tr>\r\n            </thead>\r\n            <tbody>\r\n              <tr>\r\n                <td>{props.distanceFromStartCM}</td>\r\n                <td>{props.distanceTraveledInCM}</td>\r\n                <td>{props.totalDistanceTraveledInCM}</td>\r\n                <td>{toLatLong(props.geoData)[0]}</td>\r\n                <td>{toLatLong(props.geoData)[1]}</td>\r\n                <td>{toTime(props.geoData)}</td>\r\n              </tr>\r\n            </tbody>\r\n          </Table>\r\n        </React.Fragment>\r\n      )}\r\n      <section>\r\n        <h2>Badges</h2>\r\n        <div>\r\n          <Badge>hey</Badge>\r\n        </div>\r\n      </section>\r\n    </Modal>\r\n  );\r\n}\r\n\r\nDisplayData.propTypes = {\r\n  start: PropTypes.oneOfType([PropTypes.object, PropTypes.bool]),\r\n  distanceFromStartCM: PropTypes.number,\r\n  totalDistanceTraveledInCM: PropTypes.number,\r\n  startingLocation: PropTypes.object,\r\n  geoData: PropTypes.object,\r\n};\r\n\r\nexport default DisplayData;\r\n","C:\\Users\\tsapo\\Github\\walk-hero\\src\\components\\Map\\Map.js",[],"C:\\Users\\tsapo\\Github\\walk-hero\\src\\components\\BottomNav\\BottomNav.js",[],"C:\\Users\\tsapo\\Github\\walk-hero\\src\\utils.js",[],"C:\\Users\\tsapo\\Github\\walk-hero\\src\\enums.js",[],{"ruleId":"55","severity":1,"message":"56","line":68,"column":11,"nodeType":"57","messageId":"58","endLine":68,"endColumn":18},{"ruleId":"59","replacedBy":"60"},{"ruleId":"61","replacedBy":"62"},{"ruleId":"55","severity":1,"message":"63","line":7,"column":3,"nodeType":"57","messageId":"58","endLine":7,"endColumn":12},{"ruleId":"55","severity":1,"message":"64","line":8,"column":3,"nodeType":"57","messageId":"58","endLine":8,"endColumn":14},{"ruleId":"55","severity":1,"message":"65","line":9,"column":3,"nodeType":"57","messageId":"58","endLine":9,"endColumn":14},"no-unused-vars","'latLong' is assigned a value but never used.","Identifier","unusedVar","no-native-reassign",["66"],"no-negated-in-lhs",["67"],"'ModalBody' is defined but never used.","'ModalFooter' is defined but never used.","'ModalHeader' is defined but never used.","no-global-assign","no-unsafe-negation"]