[{"C:\\Users\\tsapo\\Github\\walk-hero\\src\\index.js":"1","C:\\Users\\tsapo\\Github\\walk-hero\\src\\reportWebVitals.js":"2","C:\\Users\\tsapo\\Github\\walk-hero\\src\\App.js":"3","C:\\Users\\tsapo\\Github\\walk-hero\\src\\services\\Geo.js":"4","C:\\Users\\tsapo\\Github\\walk-hero\\src\\workers\\cities.js":"5","C:\\Users\\tsapo\\Github\\walk-hero\\src\\workers\\measurements.js":"6","C:\\Users\\tsapo\\Github\\walk-hero\\src\\components\\DisplayData\\DisplayData.js":"7","C:\\Users\\tsapo\\Github\\walk-hero\\src\\components\\Map\\Map.js":"8"},{"size":501,"mtime":1611953490515,"results":"9","hashOfConfig":"10"},{"size":362,"mtime":499162500000,"results":"11","hashOfConfig":"10"},{"size":4303,"mtime":1612525194452,"results":"12","hashOfConfig":"10"},{"size":1115,"mtime":1612523141662,"results":"13","hashOfConfig":"10"},{"size":639,"mtime":1612474933362,"results":"14","hashOfConfig":"10"},{"size":497,"mtime":1612471425300,"results":"15","hashOfConfig":"10"},{"size":2249,"mtime":1612525671236,"results":"16","hashOfConfig":"10"},{"size":1222,"mtime":1612485028225,"results":"17","hashOfConfig":"10"},{"filePath":"18","messages":"19","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"20"},"1qws8st",{"filePath":"21","messages":"22","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"20"},{"filePath":"23","messages":"24","errorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"25","usedDeprecatedRules":"20"},{"filePath":"26","messages":"27","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"20"},{"filePath":"28","messages":"29","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"20"},{"filePath":"30","messages":"31","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"32"},{"filePath":"33","messages":"34","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"20"},{"filePath":"35","messages":"36","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"20"},"C:\\Users\\tsapo\\Github\\walk-hero\\src\\index.js",[],["37","38"],"C:\\Users\\tsapo\\Github\\walk-hero\\src\\reportWebVitals.js",[],"C:\\Users\\tsapo\\Github\\walk-hero\\src\\App.js",["39"],"import React from \"react\";\nimport { Container, Row, Col, UncontrolledCollapse } from \"reactstrap\";\n\nimport {\n  toLatLong,\n  startPoll,\n  killPoll,\n  getStartingPoint,\n  cloneGeoData,\n} from \"./services/Geo\";\nimport cityWorker from \"workerize-loader!./workers/cities\"; // eslint-disable-line import/no-webpack-loader-syntax\nimport measureWorker from \"workerize-loader!./workers/measurements\"; // eslint-disable-line import/no-webpack-loader-syntax\n\nimport DisplayData from \"./components/DisplayData/DisplayData\";\nimport Map from \"./components/Map/Map\";\n\nconst CityWorker = cityWorker();\nconst MeasurementWorker = measureWorker();\n\nclass App extends React.Component {\n  constructor(props) {\n    super(props);\n\n    this.state = {\n      geoData: {\n        coords: {},\n      },\n      farthestGeoDataFromStart: null,\n      hasLocation: false,\n      start: false,\n      distanceFromStartCM: 0,\n      prevGeoData: {},\n      distanceTraveledInCM: 0,\n      totalDistanceTraveledInCM: 0,\n      startingLocation: {},\n    };\n\n    this.poll = null;\n    this.map = null;\n  }\n\n  componentDidMount() {\n    this.poll = startPoll(this.success);\n    getStartingPoint(this.setStart);\n    this.cityPoll = setInterval(\n      () => this.getCurrentCity(cloneGeoData(this.state.geoData)),\n      12000\n    );\n  }\n\n  componentWillUnmount() {\n    killPoll(this.poll);\n    clearInterval(this.cityPoll);\n  }\n\n  setStart = (data) => {\n    const latLong = toLatLong(data);\n    this.setState({ start: data, geoData: data }, () => {\n      this.getCurrentCity(cloneGeoData(data));\n    });\n  };\n\n  getCurrentCity = (latLong) => {\n    CityWorker.getEntryByLatLong(latLong).then((value) => {\n      if (value.length !== 0) {\n        this.setState({ startingLocation: value[0] });\n      } else {\n        this.setState({\n          failedAtCity: true,\n          startingLocation: {\n            name: \"Could not find city\",\n            country: \"Could not find country\",\n          },\n        });\n      }\n    });\n  };\n\n  success = (geoData) => {\n    this.calculateFarthestGeo(geoData);\n    this.calculatePointToPointFromStart(geoData);\n    this.calculateTotalDistanceTraveledInCM(geoData);\n\n    this.setState({\n      geoData,\n    });\n  };\n\n  calculatePointToPointFromStart = (_geoData) => {\n    let _distFromStart = null;\n\n    MeasurementWorker.distBetweenInCM(\n      cloneGeoData(this.state.start),\n      cloneGeoData(_geoData)\n    ).then((value) => {\n      _distFromStart = value;\n      this.setState({\n        distanceFromStartCM: _distFromStart,\n      });\n    });\n  };\n\n  calculateTotalDistanceTraveledInCM = (_geoData) => {\n    let _distTraveled = null;\n\n    MeasurementWorker.distBetweenInCM(\n      cloneGeoData(_geoData),\n      cloneGeoData(this.state.geoData)\n    ).then((value) => {\n      _distTraveled = value;\n      if (_distTraveled >= 500) {\n        this.setState({\n          totalDistanceTraveledInCM:\n            this.state.totalDistanceTraveledInCM + _distTraveled,\n        });\n      }\n      this.setState({\n        distanceTraveledInCM: _distTraveled,\n      });\n    });\n  };\n\n  calculateFarthestGeo = (_geoData) => {\n    let _farthestGeoData = null;\n\n    if (this.state.farthestGeoDataFromStart) {\n      MeasurementWorker.distBetweenInCM(\n        cloneGeoData(this.state.farthestGeoDataFromStart),\n        cloneGeoData(this.state.start)\n      ).then((value1) => {\n        MeasurementWorker.distBetweenInCM(\n          cloneGeoData(_geoData),\n          cloneGeoData(this.state.farthestGeoDataFromStart)\n        ).then((value2) => {\n          if (value2 > value1) {\n            _farthestGeoData = _geoData;\n            this.setState({ farthestGeoDataFromStart: _farthestGeoData });\n          }\n        });\n      });\n    } else {\n      _farthestGeoData = _geoData;\n      this.setState({ farthestGeoDataFromStart: _farthestGeoData });\n    }\n  };\n\n  render() {\n    return (\n      <Container>\n        <Row>\n          <Col xs={12}>\n            <a href=\"#data\" id=\"dataToggler\">\n              Data\n            </a>\n            <UncontrolledCollapse id=\"data\" toggler=\"#dataToggler\">\n              <DisplayData {...this.state} />\n            </UncontrolledCollapse>\n          </Col>\n          <Col xs={12}>\n            <Map geoData={this.state.geoData} />\n          </Col>\n        </Row>\n      </Container>\n    );\n  }\n}\n\nexport default App;\n","C:\\Users\\tsapo\\Github\\walk-hero\\src\\services\\Geo.js",[],"C:\\Users\\tsapo\\Github\\walk-hero\\src\\workers\\cities.js",[],"C:\\Users\\tsapo\\Github\\walk-hero\\src\\workers\\measurements.js",[],["40","41"],"C:\\Users\\tsapo\\Github\\walk-hero\\src\\components\\DisplayData\\DisplayData.js",[],"C:\\Users\\tsapo\\Github\\walk-hero\\src\\components\\Map\\Map.js",[],{"ruleId":"42","replacedBy":"43"},{"ruleId":"44","replacedBy":"45"},{"ruleId":"46","severity":1,"message":"47","line":57,"column":11,"nodeType":"48","messageId":"49","endLine":57,"endColumn":18},{"ruleId":"42","replacedBy":"50"},{"ruleId":"44","replacedBy":"51"},"no-native-reassign",["52"],"no-negated-in-lhs",["53"],"no-unused-vars","'latLong' is assigned a value but never used.","Identifier","unusedVar",["52"],["53"],"no-global-assign","no-unsafe-negation"]