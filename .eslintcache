t":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"34","usedDeprecatedRules":"20"},{"filePath":"35","messages":"36","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"20"},"C:\\Users\\tsapo\\Github\\walk-hero\\src\\index.js",[],["37","38"],"C:\\Users\\tsapo\\Github\\walk-hero\\src\\reportWebVitals.js",[],"C:\\Users\\tsapo\\Github\\walk-hero\\src\\App.js",["39"],"import React from \"react\";\nimport { Container, Row, Col, UncontrolledCollapse } from \"reactstrap\";\n\nimport {\n  toLatLong,\n  startPoll,\n  killPoll,\n  getStartingPoint,\n  cloneGeoData,\n} from \"./services/Geo\";\nimport cityWorker from \"workerize-loader!./workers/cities\"; // eslint-disable-line import/no-webpack-loader-syntax\nimport measureWorker from \"workerize-loader!./workers/measurements\"; // eslint-disable-line import/no-webpack-loader-syntax\n\nimport DisplayData from \"./components/DisplayData/DisplayData\";\nimport Map from \"./components/Map/Map\";\n\nconst CityWorker = cityWorker();\nconst MeasurementWorker = measureWorker();\n\nclass App extends React.Component {\n  constructor(props) {\n    super(props);\n\n    this.state = {\n      geoData: {\n        coords: {},\n      },\n      farthestGeoDataFromStart: null,\n      hasLocation: false,\n      start: false,\n      distanceFromStartCM: 0,\n      prevGeoData: {},\n      distanceTraveledInCM: 0,\n      totalDistanceTraveledInCM: 0,\n      startingLocation: {},\n    };\n\n    this.poll = null;\n    this.map = null;\n  }\n\n  componentDidMount() {\n    this.poll = startPoll(this.success);\n    getStartingPoint(this.setStart);\n    this.cityPoll = setInterval(\n      () => this.getCurrentCity(cloneGeoData(this.state.geoData)),\n      12000\n    );\n  }\n\n  componentWillUnmount() {\n    killPoll(this.poll);\n    clearInterval(this.cityPoll);\n  }\n\n  setStart = (data) => {\n    const latLong = toLatLong(data);\n    this.setState({ start: data, geoData: data }, () => {\n      this.getCurrentCity(cloneGeoData(data));\n    });\n  };\n\n  getCurrentCity = (latLong) => {\n    CityWorker.getEntryByLatLong(latLong).then((value) => {\n      if (value.length !== 0) {\n        this.setState({ startingLocation: value[0] });\n      } else {\n        this.setState({\n          failedAtCity: true,\n          startingLocation: {\n            name: \"Could not find city\",\n            country: \"Could not find country\",\n          },\n        });\n      }\n    });\n  };\n\n  success = (geoData) => {\n    this.calculateFarthestGeo(geoData);\n    this.calculatePointToPointFromStart(geoData);\n    this.calculateTotalDistanceTraveledInCM(geoData);\n\n    this.setState({\n      geoData,\n    });\n  };\n\n  calculatePointToPointFromStart = (_geoData) => {\n    let _distFromStart = null;\n\n    MeasurementWorker.distBetweenInCM(\n      cloneGeoData(this.state.start),\n      cloneGeoData(_geoData)\n    ).then((value) => {\n      _distFromStart = value;\n      this.setState({\n        distanceFromStartCM: _distFromStart,\n      });\n    });\n  };\n\n  calculateTotalDistanceTraveledInCM = (_geoData) => {\n    let _distTraveled = null;\n\n    MeasurementWorker.distBetweenInCM(\n      cloneGeoData(_geoData),\n      cloneGeoData(this.state.geoData)\n    ).then((value) => {\n      _distTraveled = value;\n      this.setState({\n        distanceTraveledInCM: _distTraveled,\n        totalDistanceTraveledInCM:\n          this.state.totalDistanceTraveledInCM + _distTraveled,\n      });\n    });\n  };\n\n  calculateFarthestGeo = (_geoData) => {\n    let _farthestGeoData = null;\n\n    if (this.state.farthestGeoDataFromStart) {\n      MeasurementWorker.distBetweenInCM(\n        cloneGeoData(this.state.farthestGeoDataFromStart),\n        cloneGeoData(this.state.start)\n      ).then((value1) => {\n        MeasurementWorker.distBetweenInCM(\n          cloneGeoData(_geoData),\n          cloneGeoData(this.state.farthestGeoDataFromStart)\n        ).then((value2) => {\n          if (value2 > value1) {\n            _farthestGeoData = _geoData;\n            this.setState({ farthestGeoDataFromStart: _farthestGeoData });\n          }\n        });\n      });\n    } else {\n      _farthestGeoData = _geoData;\n      this.setState({ farthestGeoDataFromStart: _farthestGeoData });\n    }\n  };\n\n  render() {\n    return (\n      <Container>\n        <Row>\n          <Col xs={12}>\n            <a href=\"#data\" id=\"dataToggler\">\n              Data\n            </a>\n            <UncontrolledCollapse id=\"data\" toggler=\"#dataToggler\">\n              <DisplayData {...this.state} />\n            </UncontrolledCollapse>\n          </Col>\n          <Col xs={12}>\n            <Map geoData={this.state.geoData} />\n          </Col>\n        </Row>\n      </Container>\n    );\n  }\n}\n\nexport default App;\n","C:\\Users\\tsapo\\Github\\walk-hero\\src\\services\\Geo.js",[],"C:\\Users\\tsapo\\Github\\walk-hero\\src\\workers\\cities.js",[],"C:\\Users\\tsapo\\Github\\walk-hero\\src\\workers\\measurements.js",[],"C:\\Users\\tsapo\\Github\\walk-hero\\src\\components\\DisplayData\\DisplayData.js",["40"],"import React from \"react\";\r\nimport PropTypes from \"prop-types\";\r\nimport { Table, Badge } from \"reactstrap\";\r\n\r\nimport { toTime, toLatLong, cloneGeoData } from \"./../../services/Geo\";\r\n\r\nfunction DisplayData(props) {\r\n  return (\r\n    <React.Fragment>\r\n      {props.start && (\r\n        <React.Fragment>\r\n          <h2>Starting Data</h2>\r\n          <Table responsive>\r\n            <thead>\r\n              <tr>\r\n                <th>lat</th>\r\n                <th>lng</th>\r\n                <th>city</th>\r\n                <th>country</th>\r\n                <th>datetime</th>\r\n              </tr>\r\n            </thead>\r\n            <tbody>\r\n              <tr>\r\n                <td>{toLatLong(props.start)[0]}</td>\r\n                <td>{toLatLong(props.start)[1]}</td>\r\n                <td>{props.startingLocation.name}</td>\r\n                <td>{props.startingLocation.country}</td>\r\n                <td>{toTime(props.start)}</td>\r\n              </tr>\r\n            </tbody>\r\n          </Table>\r\n\r\n          <h2>Current Traveling</h2>\r\n          <Table responsive>\r\n            <thead>\r\n              <tr>\r\n                <th>cm from start</th>\r\n                <th>cm just traveled</th>\r\n                <th>total cm</th>\r\n                <th>lat</th>\r\n                <th>lng</th>\r\n                <th>time</th>\r\n              </tr>\r\n            </thead>\r\n            <tbody>\r\n              <tr>\r\n                <td>{props.distanceFromStartCM}</td>\r\n                <td>{props.distanceTraveledInCM}</td>\r\n                <td>{props.totalDistanceTraveledInCM}</td>\r\n                <td>{toLatLong(props.geoData)[0]}</td>\r\n                <td>{toLatLong(props.geoData)[1]}</td>\r\n                <td>{toTime(props.geoData)}</td>\r\n              </tr>\r\n            </tbody>\r\n          </Table>\r\n        </React.Fragment>\r\n      )}\r\n      <section>\r\n        <h2>Badges</h2>\r\n        <div>\r\n          <Badge>hey</Badge>\r\n        </div>\r\n      </section>\r\n    </React.Fragment>\r\n  );\r\n}\r\n\r\nDisplayData.propTypes = {\r\n  start: PropTypes.oneOfType([PropTypes.object, PropTypes.bool]),\r\n  distanceFromStartCM: PropTypes.number,\r\n  totalDistanceTraveledInCM: PropTypes.number,\r\n  startingLocation: PropTypes.object,\r\n  geoData: PropTypes.object,\r\n};\r\n\r\nexport default DisplayData;\r\n","C:\\Users\\tsapo\\Github\\walk-hero\\src\\components\\Map\\Map.js",[],{"ruleId":"41","replacedBy":"42"},{"ruleId":"43","replacedBy":"44"},{"ruleId":"45","severity":1,"message":"46","line":57,"column":11,"nodeType":"47","messageId":"48","endLine":57,"endColumn":18},{"ruleId":"45","severity":1,"message":"49","line":5,"column":29,"nodeType":"47","messageId":"48","endLine":5,"endColumn":41},"no-native-reassign",["50"],"no-negated-in-lhs",["51"],"no-unused-vars","'latLong' is assigned a value but never used.","Identifier","unusedVar","'cloneGeoData' is defined but never used.","no-global-assign","no-unsafe-negation"]