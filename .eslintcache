a</ModalHeader>\r\n      {props.start && (\r\n        <Container>\r\n          <Row>\r\n            <Col>\r\n              <h2>Starting Data</h2>\r\n              <Table responsive>\r\n                <thead>\r\n                  <tr>\r\n                    <th>lat</th>\r\n                    <th>lng</th>\r\n                    <th>city</th>\r\n                    <th>country</th>\r\n                    <th>datetime</th>\r\n                  </tr>\r\n                </thead>\r\n                <tbody>\r\n                  <tr>\r\n                    <td>{toLatLong(props.start)[0]}</td>\r\n                    <td>{toLatLong(props.start)[1]}</td>\r\n                    <td>{props.startingLocation.name}</td>\r\n                    <td>{props.startingLocation.country}</td>\r\n                    <td>{toTime(props.start)}</td>\r\n                  </tr>\r\n                </tbody>\r\n              </Table>\r\n\r\n              <h2>Current Traveling</h2>\r\n              <Table responsive>\r\n                <thead>\r\n                  <tr>\r\n                    <th>cm from start</th>\r\n                    <th>cm just traveled</th>\r\n                    <th>total cm</th>\r\n                    <th>lat</th>\r\n                    <th>lng</th>\r\n                    <th>time</th>\r\n                  </tr>\r\n                </thead>\r\n                <tbody>\r\n                  <tr>\r\n                    <td>{props.distanceFromStartCM}</td>\r\n                    <td>{props.distanceTraveledInCM}</td>\r\n                    <td>{props.totalDistanceTraveledInCM}</td>\r\n                    <td>{toLatLong(props.geoData)[0]}</td>\r\n                    <td>{toLatLong(props.geoData)[1]}</td>\r\n                    <td>{toTime(props.geoData)}</td>\r\n                  </tr>\r\n                </tbody>\r\n              </Table>\r\n              <section className=\"mb-3\">\r\n                <h2>Badges</h2>\r\n                <div>\r\n                  <Badge>hey</Badge>\r\n                </div>\r\n              </section>\r\n            </Col>\r\n          </Row>\r\n        </Container>\r\n      )}\r\n    </Modal>\r\n  );\r\n}\r\n\r\nDisplayData.propTypes = {\r\n  start: PropTypes.oneOfType([PropTypes.object, PropTypes.bool]),\r\n  distanceFromStartCM: PropTypes.number,\r\n  totalDistanceTraveledInCM: PropTypes.number,\r\n  startingLocation: PropTypes.object,\r\n  geoData: PropTypes.object,\r\n};\r\n\r\nexport default DisplayData;\r\n","C:\\Users\\tsapo\\Github\\walk-hero\\src\\components\\Map\\Map.js",[],"C:\\Users\\tsapo\\Github\\walk-hero\\src\\components\\BottomNav\\BottomNav.js",["53"],"import React, { Component } from \"react\";\r\nimport PropTypes from 'prop-types';\r\nimport { FaWalking } from \"react-icons/fa\";\r\nimport { Button } from \"reactstrap\";\r\n\r\nimport {fire} from \"./../../utils\";\r\nimport {CUSTOMEVENTS} from \"./../../enums\";\r\n\r\nimport \"./BottomNav.scss\";\r\n\r\nclass BottomNav extends Component {\r\n\r\n  openData = () =>{\r\n    fire(CUSTOMEVENTS.DATA_MODAL_TOGGLE)\r\n  }\r\n\r\n  render() {\r\n    return (\r\n      <div className=\"BottomNav\">\r\n        <h1 className=\"BottomNav__title\">Walk Hero</h1>\r\n        <Button className=\"BottomNav__icon\" onClick={this.openData}>\r\n          <FaWalking />\r\n        </Button>\r\n      </div>\r\n    );\r\n  }\r\n}\r\n\r\n\r\n\r\nexport default BottomNav;","C:\\Users\\tsapo\\Github\\walk-hero\\src\\utils.js",[],"C:\\Users\\tsapo\\Github\\walk-hero\\src\\enums.js",[],{"ruleId":"54","replacedBy":"55"},{"ruleId":"56","replacedBy":"57"},{"ruleId":"58","severity":1,"message":"59","line":7,"column":3,"nodeType":"60","messageId":"61","endLine":7,"endColumn":12},{"ruleId":"58","severity":1,"message":"62","line":8,"column":3,"nodeType":"60","messageId":"61","endLine":8,"endColumn":14},{"ruleId":"58","severity":1,"message":"63","line":2,"column":8,"nodeType":"60","messageId":"61","endLine":2,"endColumn":17},"no-native-reassign",["64"],"no-negated-in-lhs",["6